#!/usr/bin/env bash
set -euo pipefail

VERSION="1.0.3"

BASE_DIR="${BASE_DIR:-/opt/3xuisslcert}"
CONF_FILE="${CONF_FILE:-/etc/3xuisslcert.conf}"

MAIN_ID="${MAIN_ID:-}"
SAN_IDS="${SAN_IDS:-}"
ACME_HOME="${ACME_HOME:-/root/.acme.sh}"

TARGET_BASE_DIR="${TARGET_BASE_DIR:-/root/cert}"
TARGET_SUBDIR="${TARGET_SUBDIR:-ip}"

SERVICE="${SERVICE:-x-ui}"
CHALLENGE="${CHALLENGE:-standalone}"     # standalone | webroot
WEBROOT="${WEBROOT:-/var/www/html}"

UFW_TEMP_80="${UFW_TEMP_80:-auto}"
UFW_OPEN80_ONLY_WHEN_DUE="${UFW_OPEN80_ONLY_WHEN_DUE:-yes}"
UFW_OPEN80_WINDOW_SEC="${UFW_OPEN80_WINDOW_SEC:-900}"
UFW_COMMENT="${UFW_COMMENT:-3xuisslcert-acme-temp}"

RELOAD_CMD="${RELOAD_CMD:-$BASE_DIR/xui-certctl postdeploy}"

_ufw_opened=0

log() {
  echo "[$(date -Is)] $*"
}

usage() {
  cat <<'USG'
3xuisslcert / xui-certctl
Version: 1.0.3

Commands:
  xui-certctl sync [--id X] [--san Y ...] [--challenge standalone|webroot] [--webroot PATH]
  xui-certctl issue
  xui-certctl install
  xui-certctl postdeploy
  xui-certctl status
  xui-certctl version
USG
}

cleanup() {
  if [[ "${_ufw_opened}" -eq 1 ]] && command -v ufw >/dev/null 2>&1; then
    local nums
    nums="$(ufw status numbered 2>/dev/null | sed -n "s/^\\[\\s*\\([0-9]\\+\\)\\].*${UFW_COMMENT}.*$/\\1/p" | sort -rn || true)"
    if [[ -n "$nums" ]]; then
      local n
      for n in $nums; do
        yes | ufw delete "$n" >/dev/null 2>&1 || true
      done
    fi
    _ufw_opened=0
  fi
}
trap cleanup EXIT

detect_public_ip() {
  local ip=""
  if command -v curl >/dev/null 2>&1; then
    for u in "https://api.ipify.org" "https://ifconfig.me" "https://icanhazip.com"; do
      ip="$(curl -fsS --max-time 5 "$u" 2>/dev/null | tr -d ' \n\r\t' || true)"
      [[ "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] && { echo "$ip"; return 0; }
    done
  fi
  if command -v wget >/dev/null 2>&1; then
    ip="$(wget -qO- --timeout=5 https://api.ipify.org 2>/dev/null | tr -d ' \n\r\t' || true)"
    [[ "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] && { echo "$ip"; return 0; }
  fi
  if command -v ip >/dev/null 2>&1; then
    ip="$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}' || true)"
    [[ "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] && { echo "$ip"; return 0; }
  fi
  echo ""
}

if [[ -f "$CONF_FILE" ]]; then
  source "$CONF_FILE"
fi

CMD="${1:-sync}"
shift || true

while [[ $# -gt 0 ]]; do
  case "$1" in
    --id) MAIN_ID="${2:-}"; shift 2 ;;
    --san) SAN_IDS="${SAN_IDS} ${2:-}"; shift 2 ;;
    --challenge) CHALLENGE="${2:-}"; shift 2 ;;
    --webroot) WEBROOT="${2:-}"; shift 2 ;;
    -h|--help) CMD="help"; shift 1 ;;
    *) break ;;
  esac
done

SAN_IDS="$(echo "$SAN_IDS" | xargs 2>/dev/null || true)"

if [[ -z "$MAIN_ID" ]]; then
  MAIN_ID="$(detect_public_ip)"
fi

if [[ "$CMD" == "help" || "$CMD" == "-h" || "$CMD" == "--help" ]]; then
  usage
  exit 0
fi

if [[ "$CMD" == "version" ]]; then
  echo "$VERSION"
  exit 0
fi

ensure_prereq() {
  [[ -n "$MAIN_ID" ]] || { echo "ERROR: MAIN_ID empty and public IP autodetect failed"; exit 1; }
  [[ -x "$ACME_HOME/acme.sh" ]] || { echo "ERROR: acme.sh not found: $ACME_HOME/acme.sh"; exit 1; }
  command -v openssl >/dev/null 2>&1 || { echo "ERROR: openssl required"; exit 1; }
}

acme() {
  "$ACME_HOME/acme.sh" --home "$ACME_HOME" "$@"
}

is_ipv4() {
  [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]
}

has_any_ip() {
  is_ipv4 "$MAIN_ID" && return 0
  local v
  for v in $SAN_IDS; do
    is_ipv4 "$v" && return 0
  done
  return 1
}

profile_flag() {
  local h
  h="$(acme --help 2>&1 || true)"
  if grep -q -- '--cert-profile' <<<"$h"; then
    echo "--cert-profile"
  elif grep -q -- ' --profile' <<<"$h"; then
    echo "--profile"
  else
    echo ""
  fi
}

target_dir_for() {
  echo "$TARGET_BASE_DIR/$TARGET_SUBDIR/$1"
}

canon_dir()  { target_dir_for "$MAIN_ID"; }
canon_cert() { echo "$(canon_dir)/fullchain.pem"; }
canon_key()  { echo "$(canon_dir)/private.key"; }
acme_domain_dir() { echo "$ACME_HOME/${MAIN_ID}_ecc"; }

domain_conf_file() {
  local d f
  d="$(acme_domain_dir)"
  f="$d/${MAIN_ID}.conf"
  if [[ -f "$f" ]]; then
    echo "$f"
    return 0
  fi
  ls -1 "$d"/*.conf 2>/dev/null | head -n1 || true
}

next_renew_epoch() {
  local cf v
  cf="$(domain_conf_file)"
  [[ -n "$cf" && -f "$cf" ]] || { echo ""; return 0; }
  v="$(grep -E '^Le_NextRenewTime=' "$cf" 2>/dev/null | head -n1 | cut -d= -f2- | tr -d "'" || true)"
  echo "$v"
}

next_renew_str() {
  local cf v
  cf="$(domain_conf_file)"
  [[ -n "$cf" && -f "$cf" ]] || { echo ""; return 0; }
  v="$(grep -E '^Le_NextRenewTimeStr=' "$cf" 2>/dev/null | head -n1 | cut -d= -f2- | tr -d "'" || true)"
  echo "$v"
}

all_idents() {
  echo "$MAIN_ID $SAN_IDS" | xargs -n1 2>/dev/null | awk 'NF' | awk '!seen[$0]++'
}

is_listed_main() {
  acme --list 2>/dev/null | awk 'NR>1{print $1}' | grep -qx "$MAIN_ID"
}

prepare_dir() {
  local d="$1"
  mkdir -p "$d"
  chmod 700 "$TARGET_BASE_DIR" 2>/dev/null || true
  chmod 700 "$(dirname "$d")" 2>/dev/null || true
  chmod 700 "$d" 2>/dev/null || true
}

ufw_active() {
  command -v ufw >/dev/null 2>&1 || return 1
  ufw status 2>/dev/null | grep -qi '^Status:\s*active' || return 1
  return 0
}

should_open_80_now() {
  local nxt now win
  nxt="$(next_renew_epoch)"
  if [[ -z "$nxt" ]]; then
    echo "unknown"
    return 0
  fi
  now="$(date +%s)"
  win="${UFW_OPEN80_WINDOW_SEC}"
  if (( now >= nxt - win )); then
    echo "yes"
  else
    echo "no"
  fi
}

maybe_open_80() {
  local want="$UFW_TEMP_80"
  if [[ "$want" == "auto" ]]; then
    if [[ "$CHALLENGE" == "standalone" ]] && ufw_active; then
      want="yes"
    else
      want="no"
    fi
  fi
  [[ "$want" == "yes" ]] || return 0
  ufw_active || return 0
  [[ "$CHALLENGE" == "standalone" ]] || return 0

  if [[ "$UFW_OPEN80_ONLY_WHEN_DUE" == "yes" ]]; then
    local decision
    decision="$(should_open_80_now)"
    if [[ "$decision" == "no" ]]; then
      log "UFW: skip opening 80/tcp (next renew at $(next_renew_str), window=${UFW_OPEN80_WINDOW_SEC}s)"
      return 0
    fi
    if [[ "$decision" == "unknown" ]]; then
      log "UFW: next renew time unknown, opening 80/tcp for safety"
    fi
  fi

  log "UFW: temporarily allowing 80/tcp (comment=$UFW_COMMENT)"
  ufw allow in 80/tcp comment "$UFW_COMMENT" >/dev/null 2>&1 || true
  _ufw_opened=1
}

restart_service() {
  if command -v systemctl >/dev/null 2>&1; then
    systemctl restart "$SERVICE"
  else
    log "WARN: systemctl not found; cannot restart $SERVICE automatically."
  fi
}

issue_cert() {
  ensure_prereq

  if [[ "$CHALLENGE" == "standalone" ]]; then
    local old="$UFW_OPEN80_ONLY_WHEN_DUE"
    UFW_OPEN80_ONLY_WHEN_DUE="no"
    maybe_open_80
    UFW_OPEN80_ONLY_WHEN_DUE="$old"
  fi

  local args=()
  args+=(--issue --ecc)

  if has_any_ip; then
    local pf
    pf="$(profile_flag)"
    if [[ -n "$pf" ]]; then
      args+=("$pf" "shortlived")
    else
      log "WARN: no profile flag detected; issuing without explicit shortlived profile"
    fi
  fi

  if [[ "$CHALLENGE" == "standalone" ]]; then
    args+=(--standalone)
  elif [[ "$CHALLENGE" == "webroot" ]]; then
    args+=(-w "$WEBROOT")
  else
    echo "ERROR: CHALLENGE must be standalone or webroot"
    exit 1
  fi

  args+=(-d "$MAIN_ID")
  local s
  for s in $SAN_IDS; do
    args+=(-d "$s")
  done

  log "Issuing: MAIN_ID=$MAIN_ID SAN_IDS='$SAN_IDS' CHALLENGE=$CHALLENGE"
  acme "${args[@]}"
}

needs_install() {
  local src dst
  src="$(acme_domain_dir)/fullchain.cer"
  dst="$(canon_cert)"
  [[ -s "$dst" ]] || return 0
  [[ -s "$src" ]] || return 1
  [[ "$src" -nt "$dst" ]]
}

install_cert() {
  ensure_prereq
  prepare_dir "$(canon_dir)"
  log "Installing to canonical: $(canon_cert) and $(canon_key)"
  acme --install-cert -d "$MAIN_ID" --ecc \
    --fullchain-file "$(canon_cert)" \
    --key-file       "$(canon_key)" \
    --reloadcmd      "$RELOAD_CMD"
  chmod 600 "$(canon_key)" || true
}

postdeploy() {
  ensure_prereq
  [[ -s "$(canon_cert)" && -s "$(canon_key)" ]] || { log "ERROR: canonical cert/key missing"; exit 1; }

  local ident d src_cert src_key dst_cert dst_key
  src_cert="$(readlink -f "$(canon_cert)" 2>/dev/null || echo "$(canon_cert)")"
  src_key="$(readlink -f "$(canon_key)" 2>/dev/null || echo "$(canon_key)")"

  for ident in $(all_idents); do
    d="$(target_dir_for "$ident")"
    prepare_dir "$d"
    dst_cert="$d/fullchain.pem"
    dst_key="$d/private.key"

    if [[ "$(readlink -f "$dst_cert" 2>/dev/null || echo "$dst_cert")" != "$src_cert" ]]; then
      cp -f "$(canon_cert)" "$dst_cert"
    fi

    if [[ "$(readlink -f "$dst_key" 2>/dev/null || echo "$dst_key")" != "$src_key" ]]; then
      cp -f "$(canon_key)" "$dst_key"
    fi

    chmod 644 "$dst_cert" 2>/dev/null || true
    chmod 600 "$dst_key"   2>/dev/null || true
  done

  log "Restarting: $SERVICE"
  restart_service
}

status() {
  ensure_prereq
  echo "3xuisslcert version=$VERSION"
  echo "BASE_DIR=$BASE_DIR"
  echo "MAIN_ID=$MAIN_ID"
  echo "SAN_IDS=$SAN_IDS"
  echo "CHALLENGE=$CHALLENGE"
  echo "UFW_TEMP_80=$UFW_TEMP_80"
  echo "UFW_OPEN80_ONLY_WHEN_DUE=$UFW_OPEN80_ONLY_WHEN_DUE"
  echo "UFW_OPEN80_WINDOW_SEC=$UFW_OPEN80_WINDOW_SEC"
  echo "NextRenew=$(next_renew_str)"
  echo "CANON_CERT=$(canon_cert)"
  if [[ -s "$(canon_cert)" ]]; then
    openssl x509 -in "$(canon_cert)" -noout -enddate -subject
  else
    echo "No installed cert yet."
  fi
}

sync() {
  ensure_prereq

  if ! is_listed_main; then
    log "Not found in acme list -> issue"
    issue_cert
    install_cert
    exit 0
  fi

  maybe_open_80
  log "acme --cron..."
  acme --cron >/dev/null 2>&1 || true

  if needs_install; then
    log "Renewed -> install"
    install_cert
  else
    log "Up to date."
  fi
}

case "$CMD" in
  sync) sync ;;
  issue) issue_cert; install_cert ;;
  install) install_cert ;;
  postdeploy) postdeploy ;;
  status) status ;;
  *) echo "Unknown command: $CMD"; usage; exit 1 ;;
esac
